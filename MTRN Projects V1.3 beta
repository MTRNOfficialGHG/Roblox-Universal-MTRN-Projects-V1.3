local BUILT_TABS = { Info = true, Player = true, ESP = true, Fling = true }

for i, name in ipairs(TAB_LIST) do
    local btn, accent = createTab(name, i)
    tabButtons[name] = { btn = btn, accent = accent }
    local page, container = createPage(name, BUILT_TABS[name])
    pages[name] = { page = page, container = container }
    btn.MouseButton1Click:Connect(function() selectTab(name) end)
end


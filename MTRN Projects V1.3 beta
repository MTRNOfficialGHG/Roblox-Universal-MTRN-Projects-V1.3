end)

-- ═══ MAIN UPDATE LOOP (Fling + Follow + View) ═══
RunService.RenderStepped:Connect(function()
    if not ScreenGui.Parent then return end

    local myChar = LocalPlayer.Character
    local hrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    -- FLING
    if flingState.isFlinging and flingState.currentTarget then
        local target = flingState.currentTarget
        local targetHrp = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
        if targetHrp then
            flingState.spinAngle = flingState.spinAngle + math.rad(400)
            if flingState.spinAngle > math.pi * 2 then
                flingState.spinAngle = flingState.spinAngle - math.pi * 2
            end
            hrp.CFrame = CFrame.new(targetHrp.Position)
                * CFrame.Angles(0, flingState.spinAngle, 0)
        end
        return
    end

    -- FOLLOW
    if flingState.following then
        local target = flingState.following
        local targetHrp = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
        if targetHrp then
            local offset = CFrame.new(0, flingState.yOffset, -flingState.xzOffset)
            local desired = targetHrp.CFrame * offset
            hrp.CFrame = CFrame.new(desired.Position, targetHrp.Position)
        end
    end

    -- VIEW (dynamic)
    if flingState.viewing then
        local target = flingState.viewing
        local targetHum = target.Character and target.Character:FindFirstChildOfClass("Humanoid")
        if targetHum and workspace.CurrentCamera.CameraSubject ~= targetHum then
            workspace.CurrentCamera.CameraSubject = targetHum
        end
    end
end)


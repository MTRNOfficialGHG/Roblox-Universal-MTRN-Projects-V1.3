-- ─── FLY ───
local flyBodyVel
local flyConnection

local function stopFly()
    if flyConnection then flyConnection:Disconnect(); flyConnection = nil end
    if flyBodyVel then flyBodyVel:Destroy(); flyBodyVel = nil end
    local hum = getHumanoid()
    if hum then hum.PlatformStand = false end
    if flyControls then flyControls.Visible = false end
end

local function startFly()
    stopFly()

    local hrp = getHRP()
    local hum = getHumanoid()
    if not hrp or not hum then return end

    hum.PlatformStand = true

    flyBodyVel = Instance.new("BodyVelocity")
    flyBodyVel.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    flyBodyVel.Velocity = Vector3.new(0, 0, 0)
    flyBodyVel.P = 1250
    flyBodyVel.Parent = hrp

    if UserInputService.TouchEnabled and flyControls then
        flyControls.Visible = true
    end

    local camera = workspace.CurrentCamera

    flyConnection = RunService.RenderStepped:Connect(function()
        if not state.flyEnabled then return end
        if not flyBodyVel or not flyBodyVel.Parent then return end
        if not camera then camera = workspace.CurrentCamera end
        if not hrp.Parent then return end

        local camCF    = camera.CFrame
        local lookVec  = camCF.LookVector
        local rightVec = camCF.RightVector

        local pos = hrp.Position
        hrp.CFrame = CFrame.new(pos, pos + lookVec)

        local moveVec = Vector3.new(0, 0, 0)
        local usingKeys = false

        if UserInputService:IsKeyDown(Enum.KeyCode.W) then
            moveVec = moveVec + lookVec; usingKeys = true
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then
            moveVec = moveVec - lookVec; usingKeys = true
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then
            moveVec = moveVec + rightVec; usingKeys = true
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then
            moveVec = moveVec - rightVec; usingKeys = true
        end

        if not usingKeys then
            local md = hum.MoveDirection
            if md.Magnitude > 0 then
                local flatLook  = Vector3.new(lookVec.X, 0, lookVec.Z)
                local flatRight = Vector3.new(rightVec.X, 0, rightVec.Z)
                if flatLook.Magnitude  > 0 then flatLook  = flatLook.Unit  end
                if flatRight.Magnitude > 0 then flatRight = flatRight.Unit end

                local fwdAmt   = md:Dot(flatLook)
                local rightAmt = md:Dot(flatRight)

                moveVec = moveVec + lookVec * fwdAmt + rightVec * rightAmt
            end
        end

        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
            moveVec = moveVec + Vector3.new(0, 1, 0)
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
            moveVec = moveVec - Vector3.new(0, 1, 0)
        end

        if flyUpBtn and flyUpBtn:GetAttribute("Held") then
            moveVec = moveVec + Vector3.new(0, 1, 0)
        end
        if flyDownBtn and flyDownBtn:GetAttribute("Held") then
            moveVec = moveVec - Vector3.new(0, 1, 0)
        end

        if moveVec.Magnitude > 0.01 then
            flyBodyVel.Velocity = moveVec.Unit * state.flySpeed
        else
            flyBodyVel.Velocity = Vector3.new(0, 0, 0)
        end
    end)
end


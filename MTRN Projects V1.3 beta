-- ─── FLING LOOP ───
RunService.Stepped:Connect(function()
    if not flingState.active then return end
    local hrp = getHRP()
    if not hrp then return end

    if #flingState.targetList == 0 then
        flingState.active = false
        return
    end

    flingState.currentIndex = ((flingState.currentIndex - 1) % #flingState.targetList) + 1
    local target = flingState.targetList[flingState.currentIndex]

    if not target or not target.Parent then
        table.remove(flingState.targetList, flingState.currentIndex)
        return
    end

    local targetChar = target.Character
    if not targetChar then return end
    local targetHrp = targetChar:FindFirstChild("HumanoidRootPart")
    if not targetHrp then return end

    if tick() - flingState.lastSwitchTime >= 3 then
        flingState.lastSwitchTime = tick()
        flingState.currentIndex = (flingState.currentIndex % #flingState.targetList) + 1
        return
    end

    -- FLING: teleport into target + spin extremely fast
    hrp.Velocity = Vector3.new(0, 0, 0)
    hrp.RotVelocity = Vector3.new(0, 0, 0)
    hrp.CFrame = targetHrp.CFrame * CFrame.Angles(0, tick() * 100000, 0)
end)

-- ─── FOLLOW LOOP ───
RunService.RenderStepped:Connect(function()
    if not flingState.followEnabled or not flingState.followTarget then return end
    if flingState.active then return end

    local target = flingState.followTarget
    if not target or not target.Parent then
        flingState.followEnabled = false
        return
    end

    local targetChar = target.Character
    if not targetChar then return end
    local targetHrp = targetChar:FindFirstChild("HumanoidRootPart")
    if not targetHrp then return end

    local hrp = getHRP()
    if not hrp then return end

    -- In Roblox: +Z = behind, -Z = front, +X = right, -X = left
    -- We negate XZ for Z so negative slider values put you BEHIND (as user wanted)
    local offset = CFrame.new(flingState.offsetXZ, flingState.offsetY, -flingState.offsetXZ)
    hrp.CFrame = targetHrp.CFrame * offset
    hrp.Velocity = Vector3.new(0, 0, 0)
    hrp.RotVelocity = Vector3.new(0, 0, 0)
end)


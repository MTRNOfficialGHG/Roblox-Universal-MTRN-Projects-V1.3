RunService.RenderStepped:Connect(function(dt)
    if not visState.freecam then return end
    local cam = workspace.CurrentCamera
    if not cam or cam.CameraType ~= Enum.CameraType.Scriptable then return end

    local look = cam.CFrame.LookVector
    local right = cam.CFrame.RightVector

    local move = Vector3.zero
    if UserInputService:IsKeyDown(Enum.KeyCode.Up)    then move = move + look end
    if UserInputService:IsKeyDown(Enum.KeyCode.Down)  then move = move - look end
    if UserInputService:IsKeyDown(Enum.KeyCode.Right) then move = move + right end
    if UserInputService:IsKeyDown(Enum.KeyCode.Left)  then move = move - right end
    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then move = move + Vector3.yAxis end
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then move = move - Vector3.yAxis end

    if freeBtnState.up    then move = move + look end
    if freeBtnState.down  then move = move - look end
    if freeBtnState.right then move = move + right end
    if freeBtnState.left  then move = move - right end

    if move.Magnitude > 0 then
        cam.CFrame = cam.CFrame + move.Unit * freecamData.speed * dt
    end
end)

RunService.RenderStepped:Connect(function()
    if not visState.freecam then return end
    if UserInputService.TouchEnabled then return end
    local cam = workspace.CurrentCamera
    if not cam or cam.CameraType ~= Enum.CameraType.Scriptable then return end

    local delta = UserInputService:GetMouseDelta()
    if delta.X == 0 and delta.Y == 0 then return end

    local sens = 0.003
    cam.CFrame = cam.CFrame
        * CFrame.Angles(0, -delta.X * sens, 0)
        * CFrame.Angles(-delta.Y * sens, 0, 0)
end)


local function isSameTeam(plr)
    if not espState.teamCheck then return false end
    if not LocalPlayer.Team or not plr.Team then return false end
    return plr.Team == LocalPlayer.Team
end

local function getEspColor(plr)
    return isSameTeam(plr) and ESP_COLORS.Team or ESP_COLORS.Enemy
end

local function getHpColor(hp, maxHp)
    local ratio = math.clamp(hp / math.max(maxHp, 1), 0, 1)
    if ratio > 0.6 then return Color3.fromRGB(90, 220, 110)
    elseif ratio > 0.3 then return Color3.fromRGB(245, 205, 70)
    else return Color3.fromRGB(230, 60, 60) end
end

local function createEspData(plr)
    if not HAS_DRAWING then return nil end
    local data = {
        box = Drawing.new("Square"), boxOutline = Drawing.new("Square"),
        name = Drawing.new("Text"), distance = Drawing.new("Text"),
        hpBarBg = Drawing.new("Square"), hpBarFill = Drawing.new("Square"),
        skeleton = {}, highlight = nil,
    }
    data.box.Thickness = 1; data.box.Filled = false; data.box.Transparency = 1; data.box.Visible = false
    data.boxOutline.Thickness = 3; data.boxOutline.Filled = false
    data.boxOutline.Color = Color3.new(0, 0, 0); data.boxOutline.Transparency = 0.4; data.boxOutline.Visible = false
    data.name.Size = 14; data.name.Center = true; data.name.Outline = true
    data.name.OutlineColor = Color3.new(0, 0, 0); data.name.Visible = false
    data.distance.Size = 12; data.distance.Center = true; data.distance.Outline = true
    data.distance.OutlineColor = Color3.new(0, 0, 0); data.distance.Visible = false
    data.hpBarBg.Filled = true; data.hpBarBg.Color = Color3.new(0, 0, 0)
    data.hpBarBg.Transparency = 0.4; data.hpBarBg.Visible = false
    data.hpBarFill.Filled = true; data.hpBarFill.Transparency = 1; data.hpBarFill.Visible = false
    espCache[plr] = data
    return data
end

local function removeEspData(plr)
    local data = espCache[plr]
    if not data then return end
    pcall(function()
        for _, v in pairs(data.skeleton) do v:Remove() end
        data.box:Remove(); data.boxOutline:Remove(); data.name:Remove()
        data.distance:Remove(); data.hpBarBg:Remove(); data.hpBarFill:Remove()
        if data.highlight then data.highlight:Destroy() end
    end)
    espCache[plr] = nil
end

local function hideAllEsp(data)
    if not data then return end
    data.box.Visible = false; data.boxOutline.Visible = false
    data.name.Visible = false; data.distance.Visible = false
    data.hpBarBg.Visible = false; data.hpBarFill.Visible = false
    for _, line in pairs(data.skeleton) do line.Visible = false end
    if data.highlight then data.highlight.Enabled = false end
end

local function ensureSkeletonLines(data, char)
    local r15 = char:FindFirstChild("UpperTorso") ~= nil
    local connections = r15 and SKELETON_R15 or SKELETON_R6
    if #data.skeleton == #connections then return connections end
    for _, line in pairs(data.skeleton) do line:Remove() end
    data.skeleton = {}
    for i = 1, #connections do
        local line = Drawing.new("Line")
        line.Thickness = 1; line.Transparency = 1; line.Visible = false
        data.skeleton[i] = line
    end
    return connections
end

local function updateEspFor(plr, data, camera)
    local char = plr.Character
    if not char then hideAllEsp(data); return end

    local hrp  = char:FindFirstChild("HumanoidRootPart")
    local hum  = char:FindFirstChildOfClass("Humanoid")
    local head = char:FindFirstChild("Head")
    if not hrp or not hum or not head or hum.Health <= 0 then hideAllEsp(data); return end

    local color = getEspColor(plr)
    local myChar = LocalPlayer.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local dist = myHrp and math.floor((hrp.Position - myHrp.Position).Magnitude) or 0

    local topScreen, topOn = camera:WorldToViewportPoint(hrp.Position + Vector3.new(0, 3, 0))
    local botScreen, botOn = camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
    local onScreen = topOn and botOn and topScreen.Z > 0

    if espState.chams then
        if not data.highlight or data.highlight.Parent ~= char then
            if data.highlight then data.highlight:Destroy() end
            local hl = Instance.new("Highlight")
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.FillTransparency = 0.55; hl.OutlineTransparency = 0
            hl.Parent = char
            data.highlight = hl
        end
        data.highlight.FillColor = color
        data.highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        data.highlight.Enabled = true
    else
        if data.highlight then data.highlight.Enabled = false end
    end

    if not onScreen then
        data.box.Visible = false; data.boxOutline.Visible = false
        data.name.Visible = false; data.distance.Visible = false
        data.hpBarBg.Visible = false; data.hpBarFill.Visible = false
        for _, l in pairs(data.skeleton) do l.Visible = false end
        return
    end

    local height = math.abs(botScreen.Y - topScreen.Y)
    local width  = height * 0.55
    local posX   = topScreen.X - width / 2
    local posY   = topScreen.Y

    if espState.box then
        data.boxOutline.Position = Vector2.new(posX, posY)
        data.boxOutline.Size = Vector2.new(width, height)
        data.boxOutline.Visible = true
        data.box.Position = Vector2.new(posX, posY)
        data.box.Size = Vector2.new(width, height)
        data.box.Color = color
        data.box.Visible = true
    else
        data.box.Visible = false; data.boxOutline.Visible = false
    end

    if espState.name then
        data.name.Position = Vector2.new(topScreen.X, posY - 18)
        data.name.Text = plr.Name
        data.name.Color = color
        data.name.Visible = true
    else data.name.Visible = false end

    if espState.distance then
        data.distance.Position = Vector2.new(topScreen.X, posY + height + 2)
        data.distance.Text = "[" .. dist .. " studs]"
        data.distance.Color = color
        data.distance.Visible = true
    else data.distance.Visible = false end

    if espState.hpBar then
        local barW = 4
        local barX = posX - barW - 3
        local barY = posY
        local barH = height
        data.hpBarBg.Position = Vector2.new(barX, barY)
        data.hpBarBg.Size = Vector2.new(barW, barH)
        data.hpBarBg.Visible = true
        local hpRatio = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
        local fillH = barH * hpRatio
        data.hpBarFill.Position = Vector2.new(barX, barY + (barH - fillH))
        data.hpBarFill.Size = Vector2.new(barW, fillH)
        data.hpBarFill.Color = getHpColor(hum.Health, hum.MaxHealth)
        data.hpBarFill.Visible = true
    else
        data.hpBarBg.Visible = false; data.hpBarFill.Visible = false
    end

    if espState.skeleton then
        local connections = ensureSkeletonLines(data, char)
        for i, conn in ipairs(connections) do
            local p1 = char:FindFirstChild(conn[1])
            local p2 = char:FindFirstChild(conn[2])
            local line = data.skeleton[i]
            if p1 and p2 and line then
                local s1, on1 = camera:WorldToViewportPoint(p1.Position)
                local s2, on2 = camera:WorldToViewportPoint(p2.Position)
                if on1 and on2 and s1.Z > 0 and s2.Z > 0 then
                    line.From = Vector2.new(s1.X, s1.Y)
                    line.To = Vector2.new(s2.X, s2.Y)
                    line.Color = color
                    line.Visible = true
                else line.Visible = false end
            elseif line then line.Visible = false end
        end
    else
        for _, line in pairs(data.skeleton) do line.Visible = false end
    end
end

if HAS_DRAWING then
    for _, plr in ipairs(Players:GetPlayers()) do

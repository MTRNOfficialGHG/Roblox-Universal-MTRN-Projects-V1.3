    setStatus("Loading: " .. name .. "...", COLORS.Accent)

    task.spawn(function()
        local ok, result = pcall(function()
            local code = game:HttpGet(url)
            local fn = loadstring(code)
            if fn then fn() end
        end)

        if ok then

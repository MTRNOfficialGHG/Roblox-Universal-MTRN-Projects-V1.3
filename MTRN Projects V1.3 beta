end

-- ─── MOVING PARTS ESP (Lilane Chams für alles was sich bewegt) ───
local MOVING_ESP_COLOR            = Color3.fromRGB(180, 100, 255)  -- Lila
local MOVING_VELOCITY_THRESHOLD   = 1        -- stud/s Minimum
local MOVING_MAX_DISTANCE         = 500      -- studs Render-Radius
local MOVING_SCAN_INTERVAL        = 0.25     -- Sek zwischen Scans
local MOVING_MAX_HIGHLIGHTS       = 200      -- Performance-Cap

local movingState = {
    highlights = {},
    scanAccum = 0,
}

local function addMovingHighlight(part)
    if movingState.highlights[part] then return end
    if not part or not part.Parent then return end

    local count = 0
    for _ in pairs(movingState.highlights) do count += 1 end
    if count >= MOVING_MAX_HIGHLIGHTS then return end

    local hl = Instance.new("Highlight")
    hl.FillColor            = MOVING_ESP_COLOR
    hl.OutlineColor         = MOVING_ESP_COLOR
    hl.FillTransparency     = 0.5
    hl.OutlineTransparency  = 0
    hl.DepthMode            = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent               = part
    movingState.highlights[part] = hl
end

local function removeMovingHighlight(part)
    local hl = movingState.highlights[part]
    if hl then
        pcall(function() hl:Destroy() end)
        movingState.highlights[part] = nil
    end
end

local function clearAllMovingHighlights()
    for part, hl in pairs(movingState.highlights) do
        pcall(function() hl:Destroy() end)
    end
    movingState.highlights = {}
end

-- Cleanup wenn Part aus dem Spiel entfernt wird
workspace.DescendantRemoving:Connect(function(obj)
    if movingState.highlights[obj] then
        movingState.highlights[obj] = nil
    end
end)

-- Scan-Loop
RunService.Heartbeat:Connect(function(dt)
    -- Wenn Toggle aus: alles clearen und raus
    if not espState.movingParts then
        if next(movingState.highlights) ~= nil then
            clearAllMovingHighlights()
        end
        return
    end

    movingState.scanAccum += dt
    if movingState.scanAccum < MOVING_SCAN_INTERVAL then return end
    movingState.scanAccum = 0

    local camera = workspace.CurrentCamera
    if not camera then return end
    local camPos = camera.CFrame.Position

    -- 1. Bestehende Highlights prüfen (entfernen wenn nicht mehr gültig)
    local toRemove = {}
    for part in pairs(movingState.highlights) do
        if not part or not part.Parent then
            table.insert(toRemove, part)
        else
            local ok, vel = pcall(function() return part.AssemblyLinearVelocity end)
            if not ok or not vel then
                table.insert(toRemove, part)
            elseif vel.Magnitude < MOVING_VELOCITY_THRESHOLD then
                table.insert(toRemove, part)
            elseif (part.Position - camPos).Magnitude > MOVING_MAX_DISTANCE then
                table.insert(toRemove, part)
            end
        end
    end
    for _, part in ipairs(toRemove) do
        removeMovingHighlight(part)
    end

    -- 2. Neue bewegende Parts finden
    local descendants = workspace:GetDescendants()
    for _, obj in ipairs(descendants) do
        if obj:IsA("BasePart") then
            if not movingState.highlights[obj] then
                local ok, vel = pcall(function() return obj.AssemblyLinearVelocity end)
                if ok and vel and vel.Magnitude >= MOVING_VELOCITY_THRESHOLD then
                    if (obj.Position - camPos).Magnitude <= MOVING_MAX_DISTANCE then
                        addMovingHighlight(obj)
                    end
                end
            end
        end
    end
end)


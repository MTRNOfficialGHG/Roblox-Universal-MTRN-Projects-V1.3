local function startFling()
    if flingState.active then return end

    local targets = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and flingSelected[plr] and plr.Character then
            local tHRP = plr.Character:FindFirstChild("HumanoidRootPart")
            if tHRP then table.insert(targets, plr) end
        end
    end
    if #targets == 0 then
        statusLabel.Text = "Kein Spieler ausgewählt!"
        return
    end

    local myHrp = getHRP()
    if not myHrp then return end

    flingState.active = true
    flingState.targets = targets
    flingState.index = 1
    flingState.lastSwitch = tick()
    flingState.originalCF = myHrp.CFrame

    local myChar = LocalPlayer.Character
    if myChar then
        for _, part in ipairs(myChar:GetDescendants()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                part.CanCollide = false
            end
        end
    end

    myHrp.CanCollide = true
    local spin = Instance.new("BodyAngularVelocity")
    spin.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    spin.AngularVelocity = Vector3.new(99999, 99999, 99999)
    spin.P = 1250
    spin.Parent = myHrp
    flingState.angularVel = spin

    updateStatusLabel()
end

local function stopFling()
    if not flingState.active then return end
    flingState.active = false

    if flingState.angularVel then
        flingState.angularVel:Destroy()
        flingState.angularVel = nil
    end

    local myHrp = getHRP()
    local myChar = LocalPlayer.Character

    if myHrp then
        myHrp.Velocity = Vector3.new(0, 0, 0)
        myHrp.RotVelocity = Vector3.new(0, 0, 0)
        myHrp.Anchored = true

        task.wait(1)

        if flingState.originalCF then
            myHrp.CFrame = flingState.originalCF
        end
        myHrp.Velocity = Vector3.new(0, 0, 0)

        task.wait(0.15)

        myHrp.Anchored = false
    end

    if myChar then
        for _, part in ipairs(myChar:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = true
            end
        end
    end

    flingState.targets = {}
    flingState.originalCF = nil
    updateStatusLabel()
end


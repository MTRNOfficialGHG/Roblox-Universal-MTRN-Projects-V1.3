-- ═══ START FLING ═══
startFlingBtn.MouseButton1Click:Connect(function()
    if flingState.isFlinging then return end
    local hrp = getHRP()
    if not hrp then return end

    flingState.originalPosition = hrp.CFrame
    flingState.isFlinging = true
    flingState.following = nil
    resetFollowRowVisuals(nil)
    startFlingBtn.BackgroundColor3 = Color3.fromRGB(120, 220, 130)
    stopFlingBtn.BackgroundColor3 = Color3.fromRGB(200, 60, 60)

    -- Ensure CanCollide
    local myChar = LocalPlayer.Character
    if myChar then
        for _, part in ipairs(myChar:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = true end
        end
    end

    task.spawn(function()
        while flingState.isFlinging and ScreenGui.Parent do
            local list = {}
            for plr, sel in pairs(flingState.selected) do
                if sel and plr.Parent and plr.Character
                and plr.Character:FindFirstChild("HumanoidRootPart") then
                    table.insert(list, plr)
                end
            end
            table.sort(list, function(a, b) return a.Name:lower() < b.Name:lower() end)

            if #list == 0 then
                flingState.isFlinging = false
                startFlingBtn.BackgroundColor3 = Color3.fromRGB(80, 180, 100)
                break
            end

            for _, plr in ipairs(list) do
                if not flingState.isFlinging then break end
                flingState.currentTarget = plr
                task.wait(3)
            end
        end
    end)
end)


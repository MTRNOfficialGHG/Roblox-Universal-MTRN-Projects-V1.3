task.spawn(function()
    local frames, lastTick = 0, tick()
    RunService.RenderStepped:Connect(function() frames += 1 end)
    while ScreenGui.Parent do
        local now = tick()
        if now - lastTick >= 1 then
            FpsLabel.Text = "FPS: " .. math.floor(frames / (now - lastTick) + 0.5)
            frames, lastTick = 0, now
        end
        local ping = 0
        pcall(function() ping = LocalPlayer:GetNetworkPing() * 1000 end)
        if ping <= 0 then
            pcall(function() ping = Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
        end
        PingLabel.Text = "Ping: " .. math.floor(ping) .. "ms"
        PlayersLabel.Text = "Players: " .. #Players:GetPlayers() .. "/" .. Players.MaxPlayers
        task.wait(0.25)
    end
end)


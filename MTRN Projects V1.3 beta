local flingThread

local function returnToOriginal()
    if flingState.originalCF then
        local hrp = getHRP()
        if hrp then hrp.CFrame = flingState.originalCF end
        flingState.originalCF = nil
    end
end

local function restoreCollision()
    local myChar = LocalPlayer.Character
    if myChar then
        for _, v in ipairs(myChar:GetDescendants()) do
            if v:IsA("BasePart") then v.CanCollide = true end
        end
    end
end

local function stopFling()
    if not flingState.flinging then return end
    flingState.flinging = false
    if flingThread then task.cancel(flingThread); flingThread = nil end
    restoreCollision()
    returnToOriginal()
end

local function flingOneTarget(target, duration)
    local t0 = tick()
    while tick() - t0 < duration and flingState.flinging do
        local myChar = LocalPlayer.Character
        local tChar = target.Character
        if not myChar or not tChar then break end
        local myHrp = myChar:FindFirstChild("HumanoidRootPart")
        local tHrp = tChar:FindFirstChild("HumanoidRootPart")
        if not myHrp or not tHrp then break end

        -- Bei jedem Frame direkt auf das Ziel setzen (Position) mit zufälliger Rotation → hohe Winkelgeschwindigkeit
        myHrp.CFrame = tHrp.CFrame * CFrame.Angles(
            math.random() * math.pi * 2,
            math.random() * math.pi * 2,
            math.random() * math.pi * 2
        )
        myHrp.Velocity = Vector3.new(1e5, 1e5, 1e5)

        task.wait()
    end
end

local function startFling()
    if flingState.flinging then return end

    -- Ausgewählte sammeln (in alphabetischer Reihenfolge)
    local targets = {}
    for plr, sel in pairs(flingState.selected) do
        if sel and plr.Parent and plr.Character then
            table.insert(targets, plr)
        end
    end
    if #targets == 0 then return end
    table.sort(targets, function(a, b) return string.lower(a.Name) < string.lower(b.Name) end)

    -- Ausgangsposition speichern
    local hrp = getHRP()
    if hrp then flingState.originalCF = hrp.CFrame end

    -- Collision aus für flüssiges TP
    local myChar = LocalPlayer.Character
    if myChar then
        for _, v in ipairs(myChar:GetDescendants()) do
            if v:IsA("BasePart") then v.CanCollide = false end
        end
    end

    flingState.flinging = true

    flingThread = task.spawn(function()
        while flingState.flinging do
            for _, target in ipairs(targets) do
                if not flingState.flinging then break end
                if not target.Parent or not target.Character then continue end
                flingOneTarget(target, 3)
            end
        end
    end)
end


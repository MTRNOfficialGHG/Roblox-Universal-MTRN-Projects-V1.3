RunService.Heartbeat:Connect(function()
    if not flingState.active then return end
    local targets = flingState.targets
    if #targets == 0 then stopFling(); return end

    if #targets > 1 then
        local now = tick()
        if now - flingState.lastSwitch > 3.8 then
            flingState.index = (flingState.index % #targets) + 1
            flingState.lastSwitch = now
        end
    else
        flingState.index = 1
    end

    local target = targets[flingState.index]
    if not target or not target.Character then
        flingState.index = (flingState.index % #targets) + 1
        return
    end

    local tHRP = target.Character:FindFirstChild("HumanoidRootPart")
    local myHrp = getHRP()
    if not tHRP or not myHrp then return end

    local jitter = Vector3.new(
        (math.random() - 0.5) * 0.2,
        (math.random() - 0.5) * 0.2,
        (math.random() - 0.5) * 0.2
    )
    myHrp.CFrame = tHRP.CFrame * CFrame.new(jitter)
    myHrp.Velocity = Vector3.new(
        math.random(-1000, 1000),
        math.random(-1000, 1000),
        math.random(-1000, 1000)
    )
end)

RunService.Heartbeat:Connect(function()
    if not followTarget then return end
    if flingState.active then return end
    if not followTarget.Character then followTarget = nil; return end

    local tHRP = followTarget.Character:FindFirstChild("HumanoidRootPart")
    local myHrp = getHRP()
    if not tHRP or not myHrp then return end

    local zOffset = -followState.xz
    local yOffset = followState.y

    local targetCF = tHRP.CFrame
    myHrp.CFrame = targetCF * CFrame.new(0, yOffset, zOffset)
    myHrp.Velocity = Vector3.zero
end)


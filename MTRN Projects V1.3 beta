        p = p.Parent
    end
    return false
end

local function applyXrayToPart(obj)
    if obj:IsA("BasePart") and not isCharPart(obj) then
        if not visState.xrayCache[obj] then
            visState.xrayCache[obj] = obj.LocalTransparencyModifier
        end
        obj.LocalTransparencyModifier = 1
    end
end

local function applyXray()
    visState.xrayCache = {}

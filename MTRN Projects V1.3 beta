local function createToggle(parent, defaultValue, callback)
    local toggle = Instance.new("TextButton")
    toggle.Size = UDim2.new(0, 44, 0, 22)
    toggle.BackgroundColor3 = defaultValue and COLORS.ToggleOn or COLORS.ToggleOff
    toggle.BorderSizePixel = 0
    toggle.Text = ""
    toggle.AutoButtonColor = false
    toggle.Parent = parent
    Instance.new("UICorner", toggle).CornerRadius = UDim.new(1, 0)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 18, 0, 18)
    knob.Position = defaultValue and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.BorderSizePixel = 0
    knob.Parent = toggle
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local state = defaultValue or false
    local function set(newState, silent)
        state = newState
        TweenService:Create(toggle, TweenInfo.new(0.2), {
            BackgroundColor3 = state and COLORS.ToggleOn or COLORS.ToggleOff
        }):Play()
        TweenService:Create(knob, TweenInfo.new(0.2), {
            Position = state and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9)
        }):Play()
        if not silent and callback then callback(state) end
    end
    toggle.MouseButton1Click:Connect(function() set(not state) end)

    return { Instance = toggle, Get = function() return state end, Set = set }
end

local function createSlider(parent, minV, maxV, defaultV, callback)
    local wrap = Instance.new("Frame")
    wrap.Size = UDim2.new(1, 0, 1, 0)
    wrap.BackgroundTransparency = 1
    wrap.Parent = parent

    local valueLabel = Instance.new("TextBox")
    valueLabel.Size = UDim2.new(0, 46, 1, 0)
    valueLabel.Position = UDim2.new(1, -46, 0, 0)
    valueLabel.BackgroundColor3 = COLORS.Row
    valueLabel.BorderSizePixel = 0
    valueLabel.Text = tostring(defaultV)
    valueLabel.Font = Enum.Font.GothamBold
    valueLabel.TextSize = 11
    valueLabel.TextColor3 = COLORS.Text
    valueLabel.ClearTextOnFocus = false
    valueLabel.TextEditable = true
    valueLabel.Parent = wrap
    Instance.new("UICorner", valueLabel).CornerRadius = UDim.new(0, 4)

    local bar = Instance.new("Frame")
    bar.Size = UDim2.new(1, -54, 0, 6)
    bar.Position = UDim2.new(0, 0, 0.5, -3)
    bar.BackgroundColor3 = COLORS.Row
    bar.BorderSizePixel = 0
    bar.Parent = wrap
    Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(0, 0, 1, 0)
    fill.BackgroundColor3 = COLORS.Accent
    fill.BorderSizePixel = 0
    fill.Parent = bar
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 14, 0, 14)
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.Position = UDim2.new(0, 0, 0.5, 0)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.BorderSizePixel = 0
    knob.ZIndex = 2
    knob.Parent = bar
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local value = defaultV
    local dragging = false
    local updatingFromText = false

    local function applyValue(v, silent)
        v = math.clamp(math.floor(v + 0.5), minV, maxV)
        value = v
        local rel = (v - minV) / (maxV - minV)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        knob.Position = UDim2.new(rel, 0, 0.5, 0)
        if not updatingFromText then
            valueLabel.Text = tostring(v)
        end
        if not silent and callback then callback(v) end
    end

    local function updateFromX(x)
        local rel = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        applyValue(minV + (maxV - minV) * rel)
    end

    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            updateFromX(input.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
            updateFromX(input.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    valueLabel.Focused:Connect(function()
        valueLabel.BackgroundColor3 = COLORS.Accent
    end)

    local function commitTextInput()
        valueLabel.BackgroundColor3 = COLORS.Row
        updatingFromText = true
        local num = tonumber(valueLabel.Text)
        if num then
            applyValue(num)
        else
            valueLabel.Text = tostring(value)
        end
        updatingFromText = false
    end

    valueLabel.FocusLost:Connect(function()
        commitTextInput()
    end)

    applyValue(defaultV, true)

    return {
        Set = function(v) applyValue(v) end,
        Get = function() return value end,
    }
end

local keybindRegistry = {}
local capturingField = nil

UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
    if capturingField then return end
    for _, entry in ipairs(keybindRegistry) do
        if entry.key == input.KeyCode and entry.enabled then
            entry.callback()
        end
    end
end)

local function createKeybind(parent, defaultKey, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 42, 0, 22)
    btn.BackgroundColor3 = COLORS.Row
    btn.BorderSizePixel = 0
    btn.Text = (defaultKey and defaultKey.Name) or "None"
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 11
    btn.TextColor3 = COLORS.SubText
    btn.AutoButtonColor = false
    btn.Parent = parent
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    local entry = { key = defaultKey, callback = callback, enabled = true }
    table.insert(keybindRegistry, entry)

    local function isCapturing() return capturingField == entry end
    btn.MouseButton1Click:Connect(function()
        if isCapturing() then
            capturingField = nil
            btn.Text = entry.key and entry.key.Name or "None"
            btn.BackgroundColor3 = COLORS.Row
            return
        end
        capturingField = entry
        btn.Text = "..."
        btn.BackgroundColor3 = COLORS.Accent
    end)

    UserInputService.InputBegan:Connect(function(input, gpe)
        if not isCapturing() then return end
        if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
        if input.KeyCode == Enum.KeyCode.Escape then
            capturingField = nil
            btn.Text = entry.key and entry.key.Name or "None"
            btn.BackgroundColor3 = COLORS.Row
            return
        end
        entry.key = input.KeyCode
        btn.Text = input.KeyCode.Name
        btn.BackgroundColor3 = COLORS.Row
        capturingField = nil
    end)

    return { Instance = btn, SetEnabled = function(v) entry.enabled = v end, Get = function() return entry.key end }
end

local function createFeature(parent, opts)
    local hasSlider = opts.Slider ~= nil
    local hasSubLabel = opts.SubLabel ~= nil
    local ROW_H = hasSubLabel and 46 or 32
    local SLIDER_H = hasSlider and 22 or 0
    local GAP = hasSlider and 6 or 0
    local totalH = ROW_H + SLIDER_H + GAP

    local feature = Instance.new("Frame")
    feature.Size = UDim2.new(1, 0, 0, totalH)
    feature.BackgroundTransparency = 1
    feature.Parent = parent

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -150, 0, 18)
    label.Position = UDim2.new(0, 0, 0, 0)
    label.BackgroundTransparency = 1
    label.Text = opts.Label
    label.Font = Enum.Font.GothamMedium
    label.TextSize = 13
    label.TextColor3 = COLORS.Text
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = feature

    if hasSubLabel then
        local sub = Instance.new("TextLabel")
        sub.Size = UDim2.new(1, -150, 0, 14)
        sub.Position = UDim2.new(0, 0, 0, 20)
        sub.BackgroundTransparency = 1
        sub.Text = opts.SubLabel
        sub.Font = Enum.Font.Gotham
        sub.TextSize = 10
        sub.TextColor3 = COLORS.SubText
        sub.TextXAlignment = Enum.TextXAlignment.Left
        sub.Parent = feature
    end

    local rightSide = Instance.new("Frame")
    rightSide.Size = UDim2.new(0, 150, 0, 32)
    rightSide.Position = UDim2.new(1, 0, 0, 0)
    rightSide.AnchorPoint = Vector2.new(1, 0)
    rightSide.BackgroundTransparency = 1
    rightSide.Parent = feature

    local rightLayout = Instance.new("UIListLayout")
    rightLayout.FillDirection = Enum.FillDirection.Horizontal
    rightLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
    rightLayout.VerticalAlignment = Enum.VerticalAlignment.Center
    rightLayout.Padding = UDim.new(0, 6)
    rightLayout.Parent = rightSide

    local keybind, toggle, slider

    if opts.Toggle then
        toggle = createToggle(rightSide, false, function(st)
            if opts.OnToggle then opts.OnToggle(st) end
        end)
        toggle.Instance.LayoutOrder = 2
    end

    if opts.Keybind then
        keybind = createKeybind(rightSide, opts.Keybind.Default, function()
            if toggle then toggle.Set(not toggle.Get())
            elseif opts.OnKeybind then opts.OnKeybind() end
        end)
        keybind.Instance.LayoutOrder = 1
    end

    if hasSlider then
        local sliderHolder = Instance.new("Frame")
        sliderHolder.Size = UDim2.new(1, 0, 0, SLIDER_H)
        sliderHolder.Position = UDim2.new(0, 0, 0, ROW_H + GAP)
        sliderHolder.BackgroundTransparency = 1
        sliderHolder.Parent = feature
        slider = createSlider(sliderHolder, opts.Slider[1], opts.Slider[2], opts.Slider[3], function(v)
            if opts.OnSlider then opts.OnSlider(v) end
        end)
    end

    return { Frame = feature, Toggle = toggle, Slider = slider, Keybind = keybind }
end


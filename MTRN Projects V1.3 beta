local MAX_LOGS = 100
local logCount = 0

local function addChatLog(speakerName, message, isLocal)
    if logCount >= MAX_LOGS then
        local lowestOrder, lowestItem = math.huge, nil
        for _, child in ipairs(ChatScroll:GetChildren()) do
            if child:IsA("TextLabel") then
                local o = child.LayoutOrder
                if o < lowestOrder then lowestOrder = o; lowestItem = child end
            end
        end
        if lowestItem then lowestItem:Destroy() end
    else
        logCount += 1
    end

    local row = Instance.new("TextLabel")
    row.Size = UDim2.new(1, 0, 0, 18)
    row.AutomaticSize = Enum.AutomaticSize.Y
    row.BackgroundTransparency = 1
    row.Font = Enum.Font.Gotham
    row.TextSize = 12
    row.TextXAlignment = Enum.TextXAlignment.Left
    row.TextYAlignment = Enum.TextYAlignment.Top
    row.TextWrapped = true
    row.LayoutOrder = math.floor(tick() * 1000)
    row.RichText = true

    local nameColor = isLocal and COLORS.LocalName or COLORS.OtherName
    local hex = string.format("#%02X%02X%02X",
        math.floor(nameColor.R * 255), math.floor(nameColor.G * 255), math.floor(nameColor.B * 255))

    local safe = message:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")
    row.Text = string.format('<font color="%s"><b>%s</b></font>: <font color="#C8D0E0">%s</font>',
        hex, speakerName, safe)
    row.Parent = ChatScroll

    task.defer(function()
        ChatScroll.CanvasPosition = Vector2.new(0, ChatScroll.AbsoluteCanvasSize.Y)
    end)
end


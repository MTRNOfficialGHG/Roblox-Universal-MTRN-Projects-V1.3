local function selectTab(name)
    for n, data in pairs(pages) do
        local active = (n == name)
        data.page.Visible = active
        tabButtons[n].btn.TextColor3 = active and COLORS.Text or COLORS.SubText
        tabButtons[n].btn.BackgroundColor3 = active and COLORS.TabHover or COLORS.Background
        tabButtons[n].accent.Visible = active
    end
end

